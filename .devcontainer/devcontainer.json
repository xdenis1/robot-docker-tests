{
    "name": "Robot Framework Development",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "d-biehl.robotcode",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "streetsidesoftware.code-spell-checker"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.linting.enabled": true,
                "robot.language-server.python": "/usr/local/bin/python",
                "robot.pythonpath": [
                    "${workspaceFolder}/tests/resources"
                ],
                "files.associations": {
                    "*.robot": "robotframework"
                }
            }
        }
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "workspaceFolder": "/workspace",
    "remoteEnv": {
        "PYTHONPATH": "/workspace/tests/resources:/workspace/tests",
        "ROBOT_OPTIONS": "--outputdir /workspace/results",
        "CHROME_BINARY_LOCATION": "/usr/bin/chromium",
        "CHROMEDRIVER_PATH": "/usr/bin/chromedriver",
        "DISPLAY": ":99"
    },
    "postCreateCommand": "bash -c 'if [ -f requirements.txt ]; then pip install -r requirements.txt; fi && xvfb-run --server-args=\"-screen 0 1920x1080x24\" chromium --version && xvfb-run --server-args=\"-screen 0 1920x1080x24\" chromedriver --version'",
    "runArgs": [
        "--security-opt=seccomp=unconfined",
        "--cap-add=SYS_ADMIN",
        "--shm-size=2g"
    ],
    "features": {
        "ghcr.io/devcontainers/features/common-utils:1": {
            "installZsh": true,
            "configureZshAsDefaultShell": true
        }
    }
}
